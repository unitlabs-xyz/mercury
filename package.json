{
  "name": "mercury",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @mercury/api dev",
    "dev:web": "pnpm --filter @mercury/web dev",
    "dev:landing": "cd apps/landing && bun run dev",
    "build:landing": "cd apps/landing && bun run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm format:check && pnpm -r typecheck && pnpm -r test",
    "dev:web:sample": "pnpm --filter @mercury/web dev:sample"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "19.2.18",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "decode-uri-component": "^0.5.0",
      "fflate": "^0.7.5",
      "shell-quote": "^1.11.0",
      "source-map-js": "^1.2.2",
      "viem": "2.56.0",
      "ws@>=8.0.0 <8.21.0": "^8.21.3"
    }
  }
}
