{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@mercury/api", "dev"],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@mercury/web",
        "dev",
        "--host",
        "127.0.0.1",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "web-sample",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@mercury/web", "dev:sample", "--port", "5174"],
      "port": 5174
    }
  ]
}
