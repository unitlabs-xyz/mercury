# Both are substituted into the bundle at build time, not read at runtime.
# In Coolify each must be ticked "Build Variable".

# The API this reads. Must be the deployment whose ADMIN_PRIVY_USER_IDS holds
# your Privy DID — the allowlist lives there, not here.
VITE_API_URL=http://localhost:8787

# The SAME Privy app as apps/web. The allowlist on the API holds Privy DIDs,
# and a different app issues different ones: a wrong app id signs you in
# successfully as a DID the API has never heard of, and every route 404s.
VITE_PRIVY_APP_ID=
