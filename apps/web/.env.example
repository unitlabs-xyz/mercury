# Privy app id, from the Privy dashboard. Required; the app throws without it.
VITE_PRIVY_APP_ID=

# Our own API. Point it at a deployment to run this frontend against one.
VITE_API_URL=http://localhost:8787

# Required. Privy signs through this RPC, and Solana's public endpoint returns
# 403 to anything sending an Origin header, so there is no default that works.
#
# Subscriptions use the same URL with http swapped for ws, so it has to be a
# provider that serves both.
#
# This ships in the bundle to every visitor. Use a key restricted by domain at
# the provider, not the one the server uses.
#
# Optional since a public endpoint that serves browsers was found: unset, or
# failing, the app falls back to it. That fallback is shared, rate limited and
# refuses indexed methods, so it is a floor under an exhausted key rather than
# something to run on.
VITE_SOLANA_RPC_URL=

# Optional, dev only. `1` serves sample data and skips login, for looking at the
# design without a backend: `pnpm dev:web:sample` sets it for you.
VITE_SAMPLE=

# Reown (WalletConnect), for connecting a wallet somebody already holds to fund
# from. Free, from the Reown dashboard. Absent, the deposit methods that need a
# wallet are hidden — nothing here throws, and the app renders as it did before.
#
# This is a public identifier and ships in the bundle, like VITE_PRIVY_APP_ID.
# Restrict it by domain in the Reown dashboard rather than treating it as a
# secret.
VITE_REOWN_PROJECT_ID=
