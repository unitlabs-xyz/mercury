# Privy. The app id is public and identifies the app; it is the same value the
# web app uses. The client id is NOT — it is created per platform in the Privy
# dashboard under Clients, bound to this bundle id (works.hashira.mercury), and
# @privy-io/expo refuses to initialise without one.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Where the app reads from. The deployed API, or http://localhost:8787 against
# a local one — note that a simulator reaches the host as localhost, a real
# device does not.
EXPO_PUBLIC_API_URL=
