---
import "../styles/global.css";
import { site } from "../config/site";
import { locales, localeOf, homePath, defaultLocale } from "../i18n";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import Reveal from "../components/Reveal.astro";
import Sound from "../components/Sound.astro";
import Analytics from "@vercel/analytics/astro";

// Preloaded because the hero is set in both of these: without it the browser only
// discovers them after the stylesheet parses, and the title reflows.
import diatypeRegular from "../assets/fonts/ABCDiatype-Regular.woff2?url";
import artnikRegular from "../assets/fonts/TTArtnik-Regular.woff2?url";

interface Props {
  title: string;
  description?: string;
  /** Extra JSON-LD blocks for this page, on top of the site-wide ones. */
  schema?: Record<string, unknown>[];
}

const locale = localeOf(Astro.url);
const t = locale.dict;
const { title, description = t.meta.description, schema = [] } = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", site.url).href;
// A new banner gets a new filename: X and LinkedIn cache previews by URL.
const ogImage = new URL("/og-mercury-v2.png", site.url).href;
const isHome = Astro.url.pathname.replace(/\/$/, "") === homePath(locale).replace(/\/$/, "");
// Every language version of this page, for search engines to pair them up.
const alternates = locales.map((l) => ({ hreflang: l.htmlLang, href: new URL(homePath(l), site.url).href }));

const baseSchema: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.name,
    url: site.url,
    logo: new URL("/icon-512.png", site.url).href,
    description: t.meta.description,
    sameAs: site.socials.map((s) => s.href),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
  },
];
---

<!doctype html>
<html lang={locale.htmlLang}>
  <head>
    {/* Set before first paint, so anything the scripts animate starts hidden
        without a flash — and stays visible if the scripts never run. */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{isHome ? site.name : `${title} — ${site.name}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(homePath(defaultLocale), site.url).href} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f3f3f3" />

    <link rel="preload" href={diatypeRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={artnikRegular} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-32-dark.png" sizes="32x32" type="image/png" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Analytics />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.htmlLang.replace("-", "_")} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />

    {
      [...baseSchema, ...schema].map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
      ))
    }
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-5 focus:top-5 focus:z-50 focus:rounded-[9px] focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      {t.ui.skip}
    </a>
    <SmoothScroll />
    <Sound />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {/* Last in the body: its inline script runs against a parsed DOM without
        waiting on DOMContentLoaded, which deferred modules hold up. */}
    <Reveal />
  </body>
</html>
