---
import { site, footerNav } from "../config/site";
import Wordmark from "./Wordmark.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-hair bg-shell">
  <div class="column py-14">
    <div class="flex flex-col justify-between gap-10 md:flex-row">
      <div>
        <Wordmark />
        <p class="mt-3 max-w-[34ch] text-[13px] text-muted">{site.tagline}</p>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-4 md:gap-16">
        {
          footerNav.map((group) => (
            <div>
              <h2 class="text-[13px] font-semibold text-ink">{group.heading}</h2>
              <ul class="mt-3 space-y-2">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-[13px] text-muted transition-colors hover:text-ink"
                      {...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <p class="mt-12 border-t border-hair pt-6 text-[12px] text-faint">
      © {year} {site.name} · Global · All rights reserved.
    </p>
  </div>
</footer>
