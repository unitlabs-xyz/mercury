---
import { site, footerNav } from "../config/site";
import { useDict } from "../i18n";
import Wordmark from "./Wordmark.astro";

const t = useDict(Astro.url);
// Keyed links read their label from the dictionary; socials carry their own.
const groups = footerNav.map((group) => ({
  heading: t.footer[group.heading],
  links: group.links.map((link) => ({
    label: "key" in link ? ({ ...t.nav, ...t.footer } as Record<string, string>)[link.key] : link.label,
    href: "href" in link ? link.href : undefined,
  })),
}));

const year = new Date().getFullYear();
---

<footer class="border-t border-hair bg-shell">
  <div class="column py-14">
    <div class="flex flex-col justify-between gap-10 md:flex-row">
      <div>
        <Wordmark />
        <p class="mt-3 whitespace-nowrap text-[13px] text-muted">{t.meta.tagline}</p>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-4 md:gap-16">
        {
          groups.map((group) => (
            <div>
              <h2 class="text-[13px] font-semibold text-ink">{group.heading}</h2>
              <ul class="mt-3 space-y-2">
                {group.links.map((link) => (
                  <li>
                    {link.href ? (
                      <a
                        href={link.href}
                        class="text-[13px] text-muted transition-colors hover:text-ink"
                        {...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}
                      >
                        {link.label}
                      </a>
                    ) : (
                      <span class="text-[13px] text-muted">{link.label}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <p class="mt-12 border-t border-hair pt-6 text-[12px] text-faint">
      © {year} {site.name} · {t.footer.rights}
    </p>
  </div>
</footer>
