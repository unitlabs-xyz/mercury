---
import { site } from "../config/site";

// Four fields and a button, in one row wherever it fits. Name and handle are optional;
// email and country are what the list is for.

// ISO 3166 regions, named in English at build time so the page ships no list
// of its own. The value stored is the name, which is what the list reads by.
const REGIONS =
  "AF AX AL DZ AS AD AO AI AQ AG AR AM AW AU AT AZ BS BH BD BB BY BE BZ BJ BM BT BO BQ BA BW BR IO BN BG BF BI CV KH CM CA KY CF TD CL CN CX CC CO KM CG CD CK CR CI HR CU CW CY CZ DK DJ DM DO EC EG SV GQ ER EE SZ ET FK FO FJ FI FR GF PF GA GM GE DE GH GI GR GL GD GP GU GT GG GN GW GY HT VA HN HK HU IS IN ID IR IQ IE IM IL IT JM JP JE JO KZ KE KI KP KR XK KW KG LA LV LB LS LR LY LI LT LU MO MG MW MY MV ML MT MH MQ MR MU YT MX FM MD MC MN ME MS MA MZ MM NA NR NP NL NC NZ NI NE NG NU NF MK MP NO OM PK PW PS PA PG PY PE PH PN PL PT PR QA RE RO RU RW BL SH KN LC MF PM VC WS SM ST SA SN RS SC SL SG SX SK SI SB SO ZA GS SS ES LK SD SR SJ SE CH SY TW TJ TZ TH TL TG TK TO TT TN TR TM TC TV UG UA AE GB US UM UY UZ VU VE VN VG VI WF EH YE ZM ZW";
const names = new Intl.DisplayNames(["en"], { type: "region" });
const countries = REGIONS.split(" ")
  .map((code) => ({ code, name: names.of(code) ?? code }))
  .sort((a, b) => a.name.localeCompare(b.name, "en"));
---

<form class="waitlist" data-waitlist action={`${site.api}/waitlist`} method="post" novalidate>
  <label class="sr-only" for="wl-name">Name</label>
  <input id="wl-name" name="name" type="text" autocomplete="name" placeholder="Name" maxlength="120" />

  <label class="sr-only" for="wl-email">Email</label>
  <input id="wl-email" name="email" type="email" autocomplete="email" placeholder="Email" required maxlength="254" />

  <label class="sr-only" for="wl-handle">X handle</label>
  <input
    id="wl-handle"
    name="handle"
    type="text"
    autocomplete="off"
    autocapitalize="off"
    spellcheck="false"
    placeholder="X handle (optional)"
    maxlength="40"
  />

  <label class="sr-only" for="wl-country">Country</label>
  <div class="select">
    <select id="wl-country" name="country" autocomplete="country-name" required>
      <option value="" disabled selected>Country</option>
      {countries.map((c) => <option value={c.name} data-code={c.code}>{c.name}</option>)}
    </select>
  </div>

  <button type="submit">Join the waitlist</button>

  <p class="status" role="status" aria-live="polite" data-waitlist-status></p>

  <button type="button" class="see-card" data-see-card hidden>See your card</button>
</form>

<!-- The card, above everything: a top-layer dialog, so no frame can clip it. -->
<dialog class="card-modal" data-card-modal aria-labelledby="card-modal-title">
  <!-- The headline and the way out, in a row above the card, as the app's dialogs open.
       No logo here: the card already carries one. -->
  <div class="card-head">
    <p class="card-title" id="card-modal-title" data-card-title></p>
    <button type="button" class="close" data-card-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
  <div class="card-frame" data-card-frame>
    <img data-card-image alt="" width="1200" height="630" />
  </div>
  <!-- What Share on X will post, so nobody is surprised by the compose window. -->
  <div class="card-post">
    <svg class="card-post-x" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    <div class="card-post-body">
      <p data-card-post></p>
      <span class="card-post-note">Your card shows as the image when you post.</span>
    </div>
  </div>
  <div class="card-actions">
    <a data-card-share target="_blank" rel="noopener" class="primary">Share on X</a>
    <button type="button" data-card-download class="ghost">Download</button>
  </div>
</dialog>

<style>
  .waitlist {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    /* Wide enough for all four fields and the button on one row. */
    width: min(100%, 880px);
  }

  input,
  select {
    flex: 1 1 120px;
    min-width: 0;
    height: 36px;
    padding: 0 14px;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 14px;
    letter-spacing: -0.02em;
    outline: none;
    transition:
      border-color 200ms var(--ease-out),
      background-color 200ms var(--ease-out);
  }

  /* The native control, restyled: no OS chrome, our own chevron, and the
     placeholder option dimmed like an input's placeholder. */
  .select {
    position: relative;
    display: flex;
    flex: 1 1 120px;
    min-width: 0;
  }

  .select::after {
    content: "";
    position: absolute;
    right: 15px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 1.3px solid rgb(255 255 255 / 0.75);
    border-bottom: 1.3px solid rgb(255 255 255 / 0.75);
    translate: 0 -70%;
    rotate: 45deg;
    pointer-events: none;
  }

  select {
    width: 100%;
    padding-right: 34px;
    appearance: none;
    cursor: pointer;
    text-overflow: ellipsis;
  }

  select:invalid {
    color: rgb(255 255 255 / 0.65);
  }

  /* The open list is drawn by the OS on a light sheet. */
  option {
    color: #000;
  }

  input::placeholder {
    color: rgb(255 255 255 / 0.65);
  }

  input:focus-visible,
  select:focus-visible {
    border-color: rgb(255 255 255 / 0.7);
    background: rgb(255 255 255 / 0.16);
  }

  input[aria-invalid="true"],
  select[aria-invalid="true"] {
    border-color: #f2a597;
  }

  /* The secondary button's material, as a real <button>. */
  button {
    flex: 0 0 auto;
    height: 36px;
    padding: 0 22px;
    border: 1px solid #f4f4f4;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
    background-image: linear-gradient(to bottom, #fff 0%, #fff 45%, #f3f3f3 50%, #fff 100%);
    background-clip: padding-box;
    background-size: 100% 200%;
    background-position: 0 100%;
    color: #000;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.02em;
    cursor: pointer;
    transition:
      background-position 220ms var(--ease-out),
      translate 220ms var(--ease-out),
      opacity 200ms linear;
  }

  button:hover,
  button:focus-visible {
    background-position: 0 0;
    translate: 0 -1px;
  }

  button:disabled {
    opacity: 0.6;
    cursor: progress;
    translate: none;
  }

  /* Hung below the fields, out of flow, so a message never moves anything. */
  .status {
    position: absolute;
    top: 100%;
    left: 0;
    margin: 8px 0 0;
    min-height: 20px;
    font-size: 13px;
    line-height: 20px;
    letter-spacing: -0.02em;
    color: rgb(255 255 255 / 0.85);
  }

  .status:empty {
    display: none;
  }

  /* Once in, the fields go: the confirmation and the way back to their card are the whole form. */
  .waitlist[data-done] > :not(.status, .see-card) {
    display: none;
  }

  .see-card[hidden] {
    display: none;
  }

  /* Their card, in a dialog over the page. */
  .card-modal {
    /* Centred by hand: the site's reset takes away the dialog's own margin: auto. */
    position: fixed;
    inset: 0;
    margin: auto;
    height: fit-content;
    width: min(720px, calc(100vw - 32px));
    max-width: none;
    padding: 20px 24px 24px;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 16px;
    background: #141614;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.35);
    color: #f3f3f3;
    letter-spacing: -0.02em;
  }

  .card-modal::backdrop {
    background: rgb(23 23 23 / 0.45);
    backdrop-filter: blur(2px);
  }

  .card-modal[open] {
    animation: card-in 280ms var(--ease-out) both;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  /* The app's dialog close: a quiet square that only fills on hover. */
  .card-modal .close {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-right: -8px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    background-image: none;
    box-shadow: none;
    color: rgb(243 243 243 / 0.6);
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-out),
      color 160ms var(--ease-out);
  }

  .card-modal .close:hover,
  .card-modal .close:focus-visible {
    background: rgb(255 255 255 / 0.08);
    color: #f3f3f3;
    translate: none;
  }

  /* The image, and the same sheen the form's art gets, played over it on open. */
  .card-frame {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 1200 / 630;
    background: rgb(255 255 255 / 0.06);
  }

  .card-frame img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-frame[data-shine]::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: screen;
    /* A medium band with eased stops, so it swells in and fades out with no
       visible edge. */
    background-image: linear-gradient(
      122deg,
      rgb(255 255 255 / 0) 38%,
      rgb(255 255 255 / 0.03) 41%,
      rgb(255 255 255 / 0.1) 44.5%,
      rgb(255 255 255 / 0.22) 48%,
      rgb(255 255 255 / 0.28) 50%,
      rgb(255 255 255 / 0.22) 52%,
      rgb(255 255 255 / 0.1) 55.5%,
      rgb(255 255 255 / 0.03) 59%,
      rgb(255 255 255 / 0) 62%
    );
    background-size: 300% 100%;
    background-repeat: no-repeat;
    animation: wl-sheen 1400ms cubic-bezier(0.4, 0, 0.2, 1) 150ms both;
  }

  .card-title {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
  }

  /* What Share on X will say: a quiet line, like a post in a feed. */
  .card-post {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  .card-post-x {
    flex: 0 0 auto;
    margin-top: 3px;
    color: rgb(243 243 243 / 0.55);
  }

  .card-post-body {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .card-post p {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    color: #f3f3f3;
  }

  .card-post-note {
    font-size: 13px;
    color: rgb(243 243 243 / 0.45);
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .card-actions .primary,
  .card-actions .ghost,
  .see-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
    cursor: pointer;
  }

  /* The app's buttons: 40px pills, 14px medium. */
  .card-actions .primary,
  .card-actions .ghost {
    height: 40px;
    padding: 0 24px;
  }

  .card-actions .primary {
    background: #fff;
    color: #171717;
  }

  .card-actions .ghost {
    border: 1px solid rgb(255 255 255 / 0.22);
    background: rgb(255 255 255 / 0.06);
    background-image: none;
    box-shadow: none;
    color: #f3f3f3;
  }

  .card-actions .primary:hover,
  .card-actions .ghost:hover {
    translate: none;
  }

  .card-actions .ghost:hover {
    background: rgb(255 255 255 / 0.12);
  }

  /* On the CTA art, so it keeps the light-on-photo look. */
  .see-card {
    border: 1px solid rgb(255 255 255 / 0.4);
    background: rgb(255 255 255 / 0.1);
    background-image: none;
    box-shadow: none;
    color: #fff;
  }

  /* The form keeps the height the fields had (locked in the script), and the
     confirmation sits where they were. */
  .waitlist[data-done] {
    align-items: center;
    gap: 16px;
  }

  .waitlist[data-done] .status {
    position: static;
    margin: 0;
    font-size: 16px;
    color: #fff;
  }

  /*
   * The success shimmer: one soft sheen that travels across the art, beneath
   * the text. A single wide gradient moved by background-position, so there
   * are no edges to see; screen, so it only ever brightens the picture; and it fades in and out as it goes, so
   * it never arrives or leaves as a layer. Made in the script and placed in
   * the art's frame, hence global.
   */
  :global(.wl-shimmer) {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    mix-blend-mode: screen;
    /* Eased stops, so the band has no visible edge — just light that swells
       and falls away. Capped at 30%: bright enough to see, never enough to
       wash the white text out. */
    background-image: linear-gradient(
      122deg,
      rgb(255 255 255 / 0) 32%,
      rgb(255 255 255 / 0.04) 38%,
      rgb(255 255 255 / 0.14) 43%,
      rgb(255 255 255 / 0.26) 48%,
      rgb(255 255 255 / 0.3) 50%,
      rgb(255 255 255 / 0.26) 52%,
      rgb(255 255 255 / 0.14) 57%,
      rgb(255 255 255 / 0.04) 62%,
      rgb(255 255 255 / 0) 68%
    );
    background-size: 300% 100%;
    background-repeat: no-repeat;
    background-position: 100% 0;
    opacity: 0;
    animation: wl-sheen 2000ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes wl-sheen {
    0% {
      background-position: 100% 0;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      background-position: 0% 0;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    input,
    select,
    button {
      transition-duration: 1ms;
    }
  }
</style>

<script>
  // Stricter than type="email", which accepts "a@b": a real domain with a dot
  // and a letters-only ending of two or more.
  const EMAIL = /^[^\s@]+@[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*\.[a-z]{2,}$/i;

  // The misspellings that account for most bad signups.
  const TYPOS: Record<string, string> = {
    "gmial.com": "gmail.com", "gmai.com": "gmail.com", "gmal.com": "gmail.com", "gamil.com": "gmail.com",
    "gnail.com": "gmail.com", "gmail.co": "gmail.com", "gmail.con": "gmail.com", "gmail.cm": "gmail.com",
    "gmaill.com": "gmail.com", "hotmial.com": "hotmail.com", "hotmai.com": "hotmail.com", "hotmail.co": "hotmail.com",
    "yahoo.co": "yahoo.com", "yaho.com": "yahoo.com", "yahooo.com": "yahoo.com", "outlok.com": "outlook.com",
    "outloo.com": "outlook.com", "outlook.co": "outlook.com", "icloud.co": "icloud.com", "iclod.com": "icloud.com",
  };

  /** One sweep of light across the art the form sits on, then gone. */
  const shimmer = (form: HTMLElement) => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const frame = form.closest(".frame");
    if (!frame) return;
    const light = document.createElement("div");
    light.className = "wl-shimmer";
    light.setAttribute("aria-hidden", "true");
    // Beneath the text: before the panel that holds the heading and form.
    const panel = [...frame.children].find((child) => child.contains(form)) ?? null;
    frame.insertBefore(light, panel);
    light.addEventListener("animationend", () => light.remove());
  };

  const form = document.querySelector<HTMLFormElement>("[data-waitlist]");
  const status = form?.querySelector<HTMLElement>("[data-waitlist-status]");

  if (form && status) {
    const email = form.elements.namedItem("email") as HTMLInputElement;
    const country = form.elements.namedItem("country") as HTMLSelectElement;
    const name = form.elements.namedItem("name") as HTMLInputElement;
    const handle = form.elements.namedItem("handle") as HTMLInputElement;

    // Start on the visitor's own country where the browser says what it is.
    const region = navigator.language.split("-")[1]?.toUpperCase();
    const mine = region ? country.querySelector<HTMLOptionElement>(`option[data-code="${region}"]`) : null;
    if (mine) mine.selected = true;

    const emailProblem = (value: string): string | null => {
      const v = value.trim();
      if (v.length === 0) return "Enter your email.";
      if (!EMAIL.test(v)) return "That doesn't look like a valid email.";
      const domain = v.split("@")[1]!.toLowerCase();
      const fix = TYPOS[domain];
      if (fix) return `Did you mean ${v.split("@")[0]}@${fix}?`;
      return null;
    };

    const mark = (el: HTMLElement, bad: boolean) => el.setAttribute("aria-invalid", String(bad));

    type Card = { position: number; founding: boolean; image: string; intent: string; wave?: string };

    // Kept in this browser until they clear it, so a return visit shows their
    // card instead of the form. Storage can be off or throw; then it is just
    // this visit.
    const KEY = "mercury:founding-card";
    const saved = (): Card | null => {
      try {
        const raw = localStorage.getItem(KEY);
        const card = raw ? (JSON.parse(raw) as Card) : null;
        return card && typeof card.position === "number" && typeof card.image === "string" ? card : null;
      } catch {
        return null;
      }
    };
    const save = (card: Card) => {
      try {
        localStorage.setItem(KEY, JSON.stringify(card));
      } catch {
        /* this visit only */
      }
    };

    const modal = document.querySelector<HTMLDialogElement>("[data-card-modal]");
    const frame = modal?.querySelector<HTMLElement>("[data-card-frame]");
    const img = modal?.querySelector<HTMLImageElement>("[data-card-image]");
    const title = modal?.querySelector<HTMLElement>("[data-card-title]");
    const share = modal?.querySelector<HTMLAnchorElement>("[data-card-share]");
    const download = modal?.querySelector<HTMLButtonElement>("[data-card-download]");
    const see = form.querySelector<HTMLButtonElement>("[data-see-card]");

    // Since the beta opened, signups are let in by wave: "Spot #612 is yours, wave 3."
    const line = (card: Card) =>
      card.wave?.startsWith("Wave ")
        ? `Spot #${card.position} is yours, ${card.wave.toLowerCase()}.`
        : card.founding
          ? `Spot #${card.position} of 500 is yours.`
          : `Spot #${card.position} is yours.`;

    // Their card, with the post one click away. X takes no image from a link,
    // so Share opens a compose window whose link unfurls into the card.
    const openCard = (card: Card) => {
      if (!modal || !frame || !img || !title || !share || !download) return;
      img.src = card.image;
      img.alt = `Your Mercury card, number ${card.position}`;
      title.textContent = line(card);
      share.href = card.intent;
      // The post's words, as the compose window opens with them. The link that
      // unfurls into the card is added by X on Share, and not shown here.
      const intent = new URL(card.intent);
      const post = modal.querySelector<HTMLElement>("[data-card-post]");
      if (post) post.textContent = intent.searchParams.get("text") ?? "";
      download.onclick = async () => {
        // Fetched, because a download attribute is ignored across origins.
        const blob = await (await fetch(card.image)).blob();
        const url = URL.createObjectURL(blob);
        const a = Object.assign(document.createElement("a"), {
          href: url,
          download: `mercury-${card.position}.png`,
        });
        a.click();
        URL.revokeObjectURL(url);
      };
      // Replayed on every open: removed, a frame to let it go, then put back.
      frame.removeAttribute("data-shine");
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        requestAnimationFrame(() => {
          frame.setAttribute("data-shine", "");
          // Heard with the sheen; Sound.astro decides whether it plays.
          dispatchEvent(new Event("mercury:shimmer"));
        });
      }
      if (!modal.open) modal.showModal();
    };

    // The form, swapped for "you're in" and a way back to the card.
    const done = (message: string, card: Card | null) => {
      form.setAttribute("data-done", "");
      status.textContent = message;
      if (see && card) {
        see.hidden = false;
        see.onclick = () => openCard(card);
      }
    };

    modal?.querySelector("[data-card-close]")?.addEventListener("click", () => modal.close());
    // A click on the backdrop lands on the dialog itself, outside its box.
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });

    const already = saved();
    if (already) done(line(already), already);

    // Checked as soon as they leave the field, not only on submit.
    email.addEventListener("blur", () => {
      if (email.value.trim().length === 0) return;
      const problem = emailProblem(email.value);
      mark(email, problem !== null);
      status.textContent = problem ?? "";
    });
    email.addEventListener("input", () => {
      if (email.getAttribute("aria-invalid") === "true" && emailProblem(email.value) === null) {
        mark(email, false);
        status.textContent = "";
      }
    });
    country.addEventListener("change", () => mark(country, false));

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const problem = emailProblem(email.value);
      mark(email, problem !== null);
      mark(country, country.value === "");
      if (problem !== null || country.value === "") dispatchEvent(new Event("mercury:error"));
      if (problem !== null) {
        status.textContent = problem;
        email.focus();
        return;
      }
      if (country.value === "") {
        status.textContent = "Pick your country.";
        country.focus();
        return;
      }

      const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      button.disabled = true;
      status.textContent = "";

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            email: email.value.trim(),
            country: country.value,
            ...(name.value.trim() ? { name: name.value.trim() } : {}),
            ...(handle.value.trim() ? { handle: handle.value.trim() } : {}),
          }),
        });
        if (res.status === 400) {
          const body = await res.json().catch(() => null);
          const message: string = body?.error?.message ?? "Check your email and country.";
          status.textContent = message;
          mark(/X handle/.test(message) ? handle : email, true);
          dispatchEvent(new Event("mercury:error"));
          button.disabled = false;
          return;
        }
        if (!res.ok) throw new Error(String(res.status));
        const joined = (await res.json().catch(() => null)) as { card?: Card } | null;
        form.style.minHeight = `${form.offsetHeight}px`;
        shimmer(form);
        const card = joined?.card;
        if (card) {
          save(card);
          done(`${line(card)} Your card is in your inbox too.`, card);
          openCard(card);
        } else {
          // A repeat signup gets no card back, by design (see the API route).
          done("You already have a spot. Your card is in your inbox.", null);
        }
        dispatchEvent(new Event("mercury:success"));
      } catch {
        status.textContent = "That didn't go through. Try again in a moment.";
        dispatchEvent(new Event("mercury:error"));
        button.disabled = false;
      }
    });
  }
</script>
