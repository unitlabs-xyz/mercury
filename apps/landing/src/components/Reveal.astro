---
/**
 * The page's first-paint script: reveal-on-scroll, the fade from each image's
 * blurred stand-in, and the fitter that scales hand-placed overlays down on a
 * narrow screen.
 *
 * Deliberately `is:inline`: both of these start their targets at opacity 0, so
 * if the code arrived as a deferred module a slow connection would show a
 * blank page until it downloaded. Inline, it ships inside the HTML and runs
 * the moment the document is parsed.
 *
 * Mark anything with `data-reveal`; add `style="--reveal-delay:120ms"` to
 * stagger a group.
 */
---

<style is:global>
  /* Above the fold. A plain CSS animation with `both` fill: it starts hidden
     and finishes visible on its own, so the first screen can never be held
     blank waiting for a script. No `.js` gate — it needs none. */
  [data-enter] {
    animation: enter 640ms var(--ease-out) var(--reveal-delay, 0ms) both;
  }

  @keyframes enter {
    from {
      opacity: 0;
      translate: 0 14px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* Below the fold, where the observer has time to arrive. */
  .js [data-reveal] {
    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 640ms var(--ease-out),
      translate 640ms var(--ease-out);
    transition-delay: var(--reveal-delay, 0ms);
    /* Only while the observer has yet to arrive: if the script never lands,
       show it anyway rather than leave a hole. The moment the script starts it
       sets `.watched` and this is gone, so the failsafe can never fire ahead
       of the scroll and spend the reveal before it is seen. */
    animation: enter 640ms var(--ease-out) 2.5s both;
  }

  .js.watched [data-reveal] {
    animation: none;
  }

  .js [data-reveal].is-in {
    opacity: 1;
    translate: 0 0;
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-enter],
    .js [data-reveal] {
      opacity: 1;
      translate: none;
      animation: none;
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const start = () => {
      const targets = Array.from(document.querySelectorAll("[data-reveal]"));
      const arts = Array.from(document.querySelectorAll("img.art"));
      const show = (el) => el.classList.add("is-in");
      const ready = (img) => img.classList.add("ready");
      const up = (el) => parseFloat(getComputedStyle(el).opacity) > 0.9;

      // On a slow line the CSS failsafe may already have brought some of this
      // up before the script arrived. Hold whatever it did, then retire it:
      // dropping the animation without this would snap those back to hidden.
      for (const el of targets) if (up(el)) show(el);
      for (const img of arts) if (up(img)) ready(img);
      document.documentElement.classList.add("watched");

      if (!("IntersectionObserver" in window)) {
        targets.forEach(show);
      } else {
        const seen = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              show(entry.target);
              seen.unobserve(entry.target);
            }
          },
          // Fire once the element is properly on screen, not as it grazes the
          // bottom edge: the trigger line sits 18% of the viewport up from the
          // bottom, so the movement plays where it can be watched.
          { rootMargin: "0px 0px -18% 0px", threshold: 0 },
        );
        targets.forEach((el) => seen.observe(el));
      }

      // Each picture fades up over its own blurred stand-in.
      for (const img of arts) {
        if (img.complete && img.naturalWidth > 0) ready(img);
        else {
          img.addEventListener("load", () => ready(img), { once: true });
          img.addEventListener("error", () => ready(img), { once: true });
        }
      }
      setTimeout(() => arts.forEach(ready), 4000);

      fit();
    };

    // Some frames hold a composition laid out in absolute pixels — a card at
    // 354 wide inside a pane at 416 — which cannot reflow without redrawing
    // it. Below the width it was drawn for, scale the whole overlay to match
    // the frame instead, so it keeps its proportions all the way down.
    const fit = () => {
      const frames = document.querySelectorAll("[data-fit]");
      if (!frames.length) return;
      const set = (el) => {
        const [dw, dh] = el.dataset.fit.split(" ").map(Number);
        const box = el.getBoundingClientRect();
        if (!dw || !dh || !box.width) return;
        // Whichever axis runs out first decides, or the card is clipped on
        // the other one.
        const ratio = Math.min(1, box.width / dw, box.height / dh);
        el.style.setProperty("--fit", ratio.toFixed(4));
      };
      frames.forEach(set);
      if ("ResizeObserver" in window) {
        const ro = new ResizeObserver((entries) => entries.forEach((e) => set(e.target)));
        frames.forEach((el) => ro.observe(el));
      } else {
        addEventListener("resize", () => frames.forEach(set), { passive: true });
      }
    };

    // Runs now, against the DOM above it. Not on DOMContentLoaded: that waits
    // for every deferred module to download, which on a slow line is the whole
    // point we are avoiding.
    start();
  })();
</script>
