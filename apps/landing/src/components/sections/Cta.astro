---
import Band from "../Band.astro";
import Waitlist from "../Waitlist.astro";
import Media from "../Media.astro";
import ctaArt from "../../assets/ui/CTA.png";
import ctaGrain from "../../assets/textures/CTATexture.png";

const content = {
  heading: ["Be first in line", "when Mercury opens."],
  note: "Leave your email and where you're from. We'll let you in as soon as it's ready.",
};

// The art is the full 1000 column at its own ratio.
const FRAME = "1000 / 286";
---

<Band id="waitlist">
  <Media
    data-reveal
    label="Join the Mercury waitlist"
    src={ctaArt}
    alt=""
    ratio={FRAME}
    radius={12}
    textureSrc={ctaGrain}
    parallax
    quality={95}
    sizes="(min-width: 1080px) 1000px, calc(100vw - 80px)"
  >
    <div class="cta-panel">
      <div>
        <h2 class="display-xl text-white">
          {content.heading[0]}{" "}<br />{content.heading[1]}
        </h2>
        <p class="mt-3 text-[16px] leading-6 tracking-[-0.02em] text-white/80">{content.note}</p>
      </div>
      <Waitlist />
    </div>
  </Media>
</Band>

<style>
  .cta-panel {
    position: absolute;
    inset: 0;
    display: flex;
    /* Title and note on top, the form beneath them, all on the left edge. */
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    padding: 36px 60px;
  }

  /* Below this the form wraps onto more lines than the art's ratio can hold. */
  @media (width < 56.25rem) {
    :global(.frame:has(> .cta-panel)) {
      --ratio: auto;
    }

    .cta-panel {
      /* Relative, not static: the art and its grain are both out of flow, so
         an unpositioned slot would be painted underneath them. */
      position: relative;
      z-index: 2;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 28px;
      padding: 40px clamp(24px, 5vw, 60px);
    }
  }
</style>
