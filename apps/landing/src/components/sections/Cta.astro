---
import { site } from "../../config/site";
import { useDict } from "../../i18n";
import Band from "../Band.astro";
import Button from "../Button.astro";
import Media from "../Media.astro";
import ctaArt from "../../assets/ui/CTA.png";
import ctaGrain from "../../assets/textures/CTATexture.png";

const t = useDict(Astro.url);
const content = { ...t.cta, action: { label: t.ui.cta, href: site.app } };

// The art is the full 1000 column at its own ratio.
const FRAME = "1000 / 286";
---

<Band id="beta">
  <Media
    data-reveal
    label={content.label}
    src={ctaArt}
    alt=""
    ratio={FRAME}
    radius={12}
    textureSrc={ctaGrain}
    parallax
    quality={95}
    sizes="(min-width: 1080px) 1000px, calc(100vw - 80px)"
  >
    <div class="cta-panel">
      <div>
        <h2 class="display-xl text-white">
          {content.heading[0]}{" "}<br />{content.heading[1]}
        </h2>
        <p class="mt-3 text-[16px] leading-6 tracking-[-0.02em] text-white/80">{content.note}</p>
      </div>
      <div>
        <Button href={content.action.href} variant="onDark">{content.action.label}</Button>
      </div>
    </div>
  </Media>
</Band>

<style>
  .cta-panel {
    position: absolute;
    inset: 0;
    /* Above the art and its grain. */
    z-index: 2;
    display: flex;
    /* Title and note on top, the button beneath them, all on the left edge. */
    flex-direction: column;
    justify-content: center;
    gap: 32px;
    padding: 28px 60px;
  }

  /* Below this the heading wraps further than the art's ratio can hold: the
     frame takes its height from the content instead. */
  @media (width < 64rem) {
    :global(.frame:has(> .cta-panel)) {
      --ratio: auto;
    }

    .cta-panel {
      /* Relative, not static: the art and its grain are both out of flow, so
         an unpositioned slot would be painted underneath them. */
      position: relative;
      z-index: 2;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 28px;
      padding: 40px clamp(24px, 5vw, 60px);
    }
  }
</style>
