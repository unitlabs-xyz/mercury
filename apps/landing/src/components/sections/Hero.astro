---
import { site } from "../../config/site";
import { useDict } from "../../i18n";
import Band from "../Band.astro";
import Button from "../Button.astro";
import Media from "../Media.astro";
import heroImage from "../../assets/ui/Hero-2x.webp";

const t = useDict(Astro.url);
/** Bump when the loop files change: they are cached for a year (vercel.json), keyed on this. */
const LOOP_VERSION = "3";
/* MP4 (H.264, fast-start) only: on a slower connection Chromium-based browsers sat on the VP9
   WebM at "metadata only" with seconds already buffered and never started, while the MP4
   starts within about a second everywhere. */
const content = { ...t.hero, primary: { label: t.ui.cta, href: site.app } };
---

<Band space="none" class="hero-band pt-[36px] pb-[50px]">
  <!-- Steps measured off the design. The headline sets its own breaks with <br>,
       so it is not capped — Artnik runs a touch wider than the drawn line and a
       520px cap would drop "built" onto a line of its own. -->
  <div>
    <!-- What it runs on, in the page's own greys: a translucent capsule on a
         hairline, Solana's mark in ink (its one-colour version) on a white
         disc. The motion is the colour: a soft glint runs round the edge, the
         mark's bars slide in as the hero arrives, and a light sheen crosses
         the name now and then. All of it stops for reduced motion. -->
    <p data-enter class="built-on relative mb-5 inline-flex h-8 items-center gap-2 rounded-full pr-3.5 pl-1 text-[13px] leading-none tracking-[-0.02em] text-copy">
      <span class="grid size-6 shrink-0 place-items-center rounded-full bg-white text-ink shadow-[0_0_0_1px_var(--color-hairline),0_1px_2px_rgba(27,26,23,0.06)]">
        <svg class="mark size-3 shrink-0" viewBox="0 0 397.7 311.7" aria-hidden="true">
          <path class="bar" style="--i:0" fill="currentColor" d="M64.6 3.8C67.1 1.4 70.4 0 73.8 0h317.4c5.8 0 8.7 7 4.6 11.1l-62.7 62.7c-2.4 2.4-5.7 3.8-9.2 3.8H6.5c-5.8 0-8.7-7-4.6-11.1L64.6 3.8z" />
          <path class="bar" style="--i:1" fill="currentColor" d="M333.1 120.1c-2.4-2.4-5.7-3.8-9.2-3.8H6.5c-5.8 0-8.7 7-4.6 11.1l62.7 62.7c2.4 2.4 5.7 3.8 9.2 3.8h317.4c5.8 0 8.7-7 4.6-11.1l-62.7-62.7z" />
          <path class="bar" style="--i:2" fill="currentColor" d="M64.6 237.9c2.4-2.4 5.7-3.8 9.2-3.8h317.4c5.8 0 8.7 7 4.6 11.1l-62.7 62.7c-2.4 2.4-5.7 3.8-9.2 3.8H6.5c-5.8 0-8.7-7-4.6-11.1l62.7-62.7z" />
        </svg>
      </span>
      {/* One run of text, so the words sit a space apart, not a flex gap. */}
      <span>
        {t.hero.builtOn[0] && `${t.hero.builtOn[0]} `}<span class="name font-medium">Solana</span>{t.hero.builtOn[1] && ` ${t.hero.builtOn[1]}`}
      </span>
    </p>

    <h1 data-enter class="display-xl text-headline">
      {content.heading[0]}{" "}<br />{content.heading[1]}
    </h1>

    <p data-enter style="--reveal-delay:150ms" class="mt-[14px] max-w-[min(520px,100%)] text-[16px] leading-[24px] text-copy">{content.lead}</p>

    <div data-enter style="--reveal-delay:210ms" class="mt-[22px] flex flex-wrap gap-3">
      <Button href={content.primary.href}>{content.primary.label}</Button>
    </div>
  </div>

  <!-- 1000 x 420 at 12px, the size it was drawn at and the full width of the column. -->
  <Media
    data-enter
    style="--reveal-delay:260ms"
    label={content.imageLabel}
    src={heroImage}
    alt=""
    ratio="1000 / 420"
    radius={12}
    texture
    quality={95}
    sizes="(min-width: 1080px) 1000px, calc(100vw - 80px)"
    priority
    class="hero-frame mt-14"
  >
    <!-- The product loop, over the hero photo it has baked in, grain and all:
         the grain sits on the photo only, never over the cards. The still's
         own grain comes from the frame's texture, under the video. The photo above
         stays the page's real image (and its LCP): the video has no poster,
         fetches nothing until the page has loaded and the frame is on screen,
         and fades in only once it is actually playing. Phones get the square
         cut. Decorative, so hidden from assistive tech and from search. -->
    <div class="screen" aria-hidden="true">
      <video class="loop wide" muted loop playsinline preload="none" disablepictureinpicture disableremoteplayback tabindex="-1">
        <source data-src={`/hero/mercury-hero-loop.mp4?v=${LOOP_VERSION}`} type="video/mp4" />
      </video>
      <video class="loop square" muted loop playsinline preload="none" disablepictureinpicture disableremoteplayback tabindex="-1">
        <source data-src={`/hero/mercury-hero-loop-mobile.mp4?v=${LOOP_VERSION}`} type="video/mp4" />
      </video>
      <!-- Inline, so the right cut starts downloading while the page is still being parsed, not
           after it: the loop is the hero, so it loads first. Only the cut that fits the screen is
           fetched. It plays itself the moment it has enough data and fades in once playing; it
           pauses out of view or in a hidden tab. Nothing loads for reduced motion or on 2G. If the
           browser refuses autoplay (an iPhone in Low Power Mode), the first scroll or tap starts it. -->
      <script is:inline>
        (() => {
          const frame = document.currentScript && document.currentScript.closest(".hero-frame");
          if (!frame) return;
          const wide = frame.querySelector("video.wide");
          const square = frame.querySelector("video.square");
          const narrow = matchMedia("(width < 40rem)");
          const still = matchMedia("(prefers-reduced-motion: reduce)");
          const conn = navigator.connection;
          if (still.matches || (conn && /(^|-)2g$/.test(conn.effectiveType || ""))) return;
          let visible = true;
          let blocked = false;
          const current = () => (narrow.matches ? square : wide);
          const other = () => (narrow.matches ? wide : square);
          const arm = (v) => {
            if (v.dataset.armed) return;
            v.dataset.armed = "1";
            v.muted = true;
            v.defaultMuted = true;
            v.playsInline = true;
            v.autoplay = true;
            v.preload = "auto";
            v.querySelectorAll("source[data-src]").forEach((s) => (s.src = s.dataset.src));
            v.addEventListener("playing", () => v.classList.add("live"), { once: true });
            v.addEventListener("canplay", sync);
            v.load();
          };
          function sync() {
            other().pause();
            const v = current();
            arm(v);
            if (still.matches || document.hidden || !visible) return v.pause();
            if (v.paused) v.play().then(() => (blocked = false), () => (blocked = true));
          }
          sync();
          new IntersectionObserver(([e]) => {
            visible = !!(e && e.isIntersecting);
            sync();
          }, { rootMargin: "200px 0px" }).observe(frame);
          narrow.addEventListener("change", sync);
          still.addEventListener("change", sync);
          document.addEventListener("visibilitychange", sync);
          const nudge = () => blocked && sync();
          ["touchstart", "pointerdown", "scroll", "keydown"].forEach((e) => addEventListener(e, nudge, { passive: true }));
        })();
      </script>
    </div>
  </Media>

  {/* Brave on desktop only: its toolbars leave a shorter window, which put the
      bottom of the hero card below the fold. Tighten the spacing, and if the
      frame still runs past the bottom, narrow it (centred, ratio kept) until it
      fits, so nothing inside is cropped. Inline, so it lands before first paint;
      offsets are summed by hand because the entrance animation translates the
      frame and would throw getBoundingClientRect off. */}
  <script is:inline>
    (() => {
      if (!navigator.brave) return;
      const root = document.documentElement;
      root.classList.add("brave");
      const frame = document.querySelector(".hero-frame");
      if (!frame) return;
      const desktop = matchMedia("(width >= 64rem)");
      const fit = () => {
        frame.style.maxWidth = "";
        if (!desktop.matches) return;
        let top = 0;
        for (let el = frame; el; el = el.offsetParent) top += el.offsetTop;
        const room = innerHeight - top - 32;
        const natural = (frame.offsetWidth * 420) / 1000;
        if (room < natural) frame.style.maxWidth = `${Math.max(640, Math.floor((room * 1000) / 420))}px`;
      };
      fit();
      addEventListener("resize", fit);
      addEventListener("load", fit);
    })();
  </script>
</Band>

<style>
  /* Barely there: a little lighter than the page, on a hairline. */
  .built-on {
    background: rgb(255 255 255 / 0.55);
    isolation: isolate;
  }

  /* The edge: a 1px hairline ring, with a soft white glint that runs round
     it once every few seconds. */
  @property --edge-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  .built-on::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    padding: 1px;
    border-radius: inherit;
    background: conic-gradient(
      from var(--edge-angle),
      var(--color-cardline) 0deg,
      var(--color-cardline) 250deg,
      #ffffff 300deg,
      var(--color-cardline) 350deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: edge-turn 6s linear infinite;
    pointer-events: none;
  }

  @keyframes edge-turn {
    to {
      --edge-angle: 360deg;
    }
  }

  /* The mark's bars, one after another, sliding in from the left. */
  .built-on .bar {
    animation: bar-in 520ms var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
    animation-delay: calc(260ms + var(--i) * 110ms);
  }

  @keyframes bar-in {
    from {
      opacity: 0;
      transform: translateX(-80px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Ink, with a soft band of Solana's violet and mint passing over it now and
     then — its colours, kept pale. Most of each cycle is still. */
  .built-on .name {
    background: linear-gradient(
        100deg,
        var(--color-ink) 0%,
        var(--color-ink) 40%,
        #b49cf0 47%,
        #7fd8b4 54%,
        var(--color-ink) 64%,
        var(--color-ink) 100%
      )
      0 0 / 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: sheen 6s ease-in-out 1.2s infinite;
  }

  @keyframes sheen {
    0% {
      background-position: 100% 0;
    }
    35%,
    100% {
      background-position: 0% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .built-on .bar,
    .built-on .name,
    .built-on::before {
      animation: none;
    }
  }

  .screen {
    position: absolute;
    inset: 0;
  }

  /* Hidden until it is really playing, then a soft fade over the photo it
     carries, so the swap from still to motion cannot be seen. */
  .loop {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 700ms var(--ease-out, ease-out);
  }

  .loop.live {
    opacity: 1;
  }

  .square {
    display: none;
  }

  /* Narrow screens: a square frame and the square loop, which keeps the
     figures readable where the wide cut would shrink them to nothing. */
  @media (width < 40rem) {
    :global(.hero-frame) {
      --ratio: 1 / 1;
    }

    .wide {
      display: none;
    }

    .square {
      display: block;
    }
  }

  @media (width >= 64rem) {
    :global(.brave .hero-frame) {
      margin-top: 36px;
      margin-inline: auto;
    }

    :global(.brave .hero-band) {
      padding-top: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loop {
      display: none !important;
    }
  }
</style>


