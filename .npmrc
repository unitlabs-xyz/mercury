# React types are NOT hoisted into the virtual store.
#
# apps/mobile is Expo on React Native 0.76, which needs @types/react 18.
# apps/landing and apps/web are React 19. pnpm hoists one copy of a package
# into .pnpm/node_modules as a fallback resolution, and it picked 18 — so
# Next's own .d.ts files resolved React 18's ReactPortal (which requires
# `children`) while the app's code used React 19's, and `tsc --noEmit` failed
# on every file that renders children.
#
# Excluding them from hoisting makes each app resolve the version it declares.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
