# PRIVATE KEYS. This service exists so that these live in one place and no
# address is ever configuration — a configured address can be one we hold no
# key for, and nothing would catch it until a refund landed somewhere
# unspendable. See docs/adr/0015-treasury-service.md.
#
# Never commit a value here. Never copy one into another service. The API asks
# this service for addresses and never sees a key.
#
# EVM:  32 bytes of hex, with or without 0x
# SVM:  a solana-keygen JSON array, base58 64 bytes, or a 32-byte seed
# BVM:  32 bytes of hex, or a mainnet WIF (a testnet WIF is refused)
TREASURY_KEY_EVM=
TREASURY_KEY_SVM=
TREASURY_KEY_BVM=

# Shared with services/api, which sends it as x-treasury-secret to read addresses.
TREASURY_SECRET=

PORT=8080
