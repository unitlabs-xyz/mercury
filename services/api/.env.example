PORT=8787

# Required. The server refuses to start without them.
DATABASE_URL=
SOLANA_RPC_URL=
# Optional. Kamino's SDK scans every reserve with getProgramAccounts, which some
# starter RPC plans (Alchemy's included) refuse as too expensive. Those scans go
# here instead; unset, Solana's public RPC is used.
SOLANA_SCAN_RPC_URL=

# Optional. Public RPC endpoints the background jobs read through, taken in turn
# and comma-separated, so they stop spending the paid plan above. Everything a
# person waits on keeps SOLANA_RPC_URL, and so does a job's request that every
# public endpoint refuses. An endpoint that refuses a method is skipped for that
# method only. Unset means the keyless endpoints that answered every read
# correctly when measured (22 October 2026): api.mainnet-beta.solana.com and
# public.rpc.solanavibestation.com (not for history, which it does not keep).
# Not PublicNode or Pocket: they answer a real transaction with null. Free-tier
# keyed URLs work here too; check one against a wallet with history before
# adding it. Set empty to keep the jobs on SOLANA_RPC_URL.
# SOLANA_PUBLIC_RPC_URLS=

# Optional. Creates or reuses Mercury's curated Solana Glider strategies once
# at API startup. Unset, catalog reconciliation is skipped.
GLIDER_API_KEY=

# Optional. Jupiter API keys from portal.jup.ag, comma separated: KEY1,KEY2,KEY3.
# Set, every Jupiter call goes to api.jup.ag and the keys take turns, one per
# request, so each key's rate limit adds up. Unset, Jupiter stays on the keyless
# free tier (lite-api.jup.ag). Server only — never put these in the web app.
#
# `JUPITER_API_KEY` is read too, for the common case of having exactly one.
JUPITER_API_KEYS=

# Optional. A Pyth Hermes key. Hermes has required `Authorization: Bearer` since
# 26 August 2026, so without one the reference price comes from the issuer's own
# feed alone — and that feed stops advancing at the closing bell, which is what
# made every out-of-hours order refuse itself.
#
# Set, the reference reads Pyth first and falls back to the issuer only where
# Pyth has no feed for a ticker or does not answer. Pyth's equity feeds close
# with the exchange too, so this narrows the gap rather than closing it.
PYTH_API_KEY=

# Privy. Both of these are public — the app id identifies the app, and the
# verification key is the public half of Privy's signing key. Access tokens and
# identity tokens are both verified offline against it, so subsystem 1 needs no
# app secret at all.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# Optional. The key that pays for sponsored transactions, so a buyer needs no
# SOL of their own. Accepts solana-keygen's JSON array or a base58 export.
#
# Unset, sponsorship is off: sends still work with the sender paying their own
# network cost, but stock trades are refused, because Mercury's trading fee is
# carried in the relayer's USDC transfer and a trade without one would be free.
#
# This is a hot key holding real SOL. It belongs in a secret store, and the
# wallet it names should hold only what sponsorship needs. Its USDC account is
# also where trading fees collect, beside the network costs it is repaid.
RELAYER_SECRET_KEY=

# Optional. Mercury's fee on a deposit Relay has to swap into USDC, in whole
# basis points of what is sent: 30 is 0.3%. Circle's own USDC is never charged.
# Unset or empty means 30; anything but a whole number from 0 to 9999 stops the
# server at boot.
DEPOSIT_FEE_BPS=
# Optional. The EVM address Relay credits deposit fees to — an EVM address even
# for deposits from Solana; Relay accepts no other kind. Relay holds the fees as
# a USDC balance until this address claims them at relay.link/claim-app-fees.
# Unset, no deposit is charged at all.
DEPOSIT_FEE_RECIPIENT=

# Optional. Mercury's fee on every stock trade, in whole basis points of what
# the trade is worth: 50 is 0.5%, 0 turns it off. Unset or empty means 50. A
# value that is not a whole number from 0 to 9999 stops the server at boot.
TRADING_FEE_BPS=

# Optional. "on" gives a friend who joins through an invite link 25% off
# Mercury's fee for 90 days. Off unless set to "on": even a discount to the
# friend is a trading incentive some markets ban, and counsel has not said it
# is allowed where Mercury launches. Invite links and counting funded friends
# work either way. Anything but "on", "off" or empty stops the server at boot.
REFERRAL_DISCOUNT=

# Optional. The Kamino Earn vault a person gets until they choose another.
# Defaults to Steakhouse USDC. It has to be a vault on Earn's list, or the first
# vault on the list is used instead.
EARN_VAULT_ADDRESS=

# Loan alerts. Unset means the watcher still runs and still writes the warning
# into the activity feed, but nothing is emailed — which it says at boot, so a
# deployment cannot quietly believe it is warning people. Resend needs no SDK;
# the adapter is one fetch.
RESEND_API_KEY=
NOTIFY_FROM=

# Optional. Where the in-app feedback form is delivered. Defaults to
# hello@trymercury.xyz. It rides the same Resend adapter, so without
# RESEND_API_KEY it is only logged.
FEEDBACK_TO=

# Vercel only, and required there. Vercel Cron sends it as
# `Authorization: Bearer <value>`, and the /cron/* routes answer 403 to
# anything else — so unset, the three daily syncs on that deployment never run
# and nothing says so. The container (index.ts) runs its jobs on its own clock
# and ignores this entirely.
CRON_SECRET=

# Optional. Relay, for adding cash from any chain it supports. Absent, the
# routes are not mounted and the interface hides the method, the same way
# sponsorship is hidden when RELAYER_SECRET_KEY is unset.
#
# The same value is the secret Relay signs its webhooks with — their choice,
# not ours — so this key is both a credential we send and one we verify against.
RELAY_API_KEY=

# Optional. What we will not quote a deposit below, in dollars. Relay does not
# sweep anything at or under $0.05, and a first deposit pays roughly $0.19 of
# token-account rent, so a floor well above both keeps the fee from being most
# of the deposit. Defaults to 10.
FUND_MINIMUM_USD=10

# Telemetry. Unset means off: the SDK never starts, the process carries no
# overhead, and the API says which at boot. Point this at the LGTM container's
# OTLP HTTP port on the private Docker network — never a public address, since
# an open OTLP ingest is an invitation to fill the disk.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional, defaults to mercury-api. The name traces are grouped under.
OTEL_SERVICE_NAME=

# How much the service says. One of trace, debug, info, warn, error, fatal,
# silent. Defaults to info. `debug` adds the decision inputs — what the gate
# saw, which wrappers were considered — which is what you want while
# reproducing one person's problem and is most of the volume otherwise.
LOG_LEVEL=

# Optional. `1` keeps stack traces in error output, which is otherwise one line
# per error. For the session that needs the frames, not for running.
LOG_STACKS=
