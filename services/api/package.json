{
  "name": "@mercury/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "allowlist": "tsx --env-file=.env scripts/allowlist-waitlist.ts",
    "backfill-fees": "tsx --env-file=.env scripts/backfill-trade-fees.ts",
    "beta-mail": "tsx --env-file-if-exists=.env scripts/beta-mail.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:waitlist": "tsx scripts/waitlist-local.ts",
    "dev:waitlist:mail": "WAITLIST_SEND_MAIL=1 tsx --env-file=.env scripts/waitlist-local.ts",
    "generate:glider-types": "openapi-typescript https://api.glider.fi/v2/openapi.json -o src/baskets/glider/generated.d.ts",
    "og-image": "tsx scripts/og-image.ts",
    "price-gap": "tsx scripts/price-gap.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vercel-build": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@kamino-finance/klend-sdk": "12.0.0",
    "@mercury/chain": "workspace:*",
    "@mercury/core": "workspace:*",
    "@mercury/market": "workspace:*",
    "@mercury/types": "workspace:*",
    "@privy-io/node": "^0.35.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@solana-program/token": "0.5.1",
    "@solana/kit": "2.3.0",
    "bn.js": "^5.2.5",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.6.0",
    "jose": "^6.2.12",
    "nanoid": "^6.0.2",
    "openapi-fetch": "^0.17.0",
    "postgres": "^3.4.9",
    "satori": "^0.35.0",
    "slugify": "^1.6.9",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@mercury/tsconfig": "workspace:*",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
