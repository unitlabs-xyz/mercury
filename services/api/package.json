{
  "name": "@mercury/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backfill-fees": "tsx --env-file=.env scripts/backfill-trade-fees.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "generate:glider-types": "openapi-typescript https://api.glider.fi/v2/openapi.json -o src/baskets/glider/generated.d.ts",
    "og-image": "tsx scripts/og-image.ts",
    "price-gap": "tsx scripts/price-gap.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vercel-build": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/otel": "^1.2.0",
    "@kamino-finance/klend-sdk": "12.0.0",
    "@mercury/chain": "workspace:*",
    "@mercury/core": "workspace:*",
    "@mercury/market": "workspace:*",
    "@mercury/types": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@privy-io/node": "^0.35.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@solana-program/token": "0.5.1",
    "@solana/kit": "2.3.0",
    "bn.js": "^5.2.5",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.6.0",
    "jose": "^6.2.12",
    "openapi-fetch": "^0.17.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "satori": "^0.35.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@mercury/tsconfig": "workspace:*",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
